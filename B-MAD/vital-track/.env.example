# API (apps/api) — copy to `.env` at repo root or set in shell; `pnpm --filter api dev` inherits env
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-only-change-me-minimum-32-characters!!
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_ADMIN_MAX=60
SWAGGER_ENABLED=true

# MongoDB (Epic 2 — auth & caregivers)
MONGODB_URI=mongodb+srv://admin:admin3189@cluster0.pog16.mongodb.net/school-scout-dcms-dev
# Dev only: if local Mongo is down, auto-use in-memory DB (localhost URIs). Set false to fail fast.
# MONGODB_MEMORY_FALLBACK=false
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7
# Optional; password-reset opaque tokens use JWT_SECRET if unset
# JWT_RESET_SECRET=
PASSWORD_RESET_EXPIRES_MIN=60

# Web (apps/web) — Vite
VITE_API_URL=http://localhost:3000

# Mobile (apps/mobile) — Expo
EXPO_PUBLIC_API_URL=http://localhost:3000
