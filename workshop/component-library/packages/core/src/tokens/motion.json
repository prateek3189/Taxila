{
  "$schema": "https://json.schemastore.org/design-tokens",
  "motion": {
    "duration": {
      "$type": "dimension",
      "0": { "$value": "0ms" },
      "75": { "$value": "75ms" },
      "100": { "$value": "100ms" },
      "150": { "$value": "150ms" },
      "200": { "$value": "200ms" },
      "300": { "$value": "300ms" },
      "500": { "$value": "500ms" },
      "700": { "$value": "700ms" },
      "1000": { "$value": "1000ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear": { "$value": "linear" },
      "in": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "out": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "bounce": { "$value": "cubic-bezier(0.68, -0.55, 0.265, 1.55)" }
    },
    "transition": {
      "$type": "transition",
      "fast": { "$value": "{motion.duration.150} {motion.easing.out}" },
      "base": { "$value": "{motion.duration.200} {motion.easing.out}" },
      "slow": { "$value": "{motion.duration.300} {motion.easing.out}" }
    }
  }
}
