{
  "name": "@featherkit/core",
  "version": "0.0.0",
  "description": "Core design tokens, utilities, and base styles for FeatherKit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./reset": {
      "types": "./dist/reset.d.ts",
      "import": "./dist/reset.js",
      "require": "./dist/reset.cjs"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "require": "./dist/utilities.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "utilities",
    "featherkit"
  ],
  "author": "FeatherKit Team",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
